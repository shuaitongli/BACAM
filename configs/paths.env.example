# Optional overrides: copy to paths.env, edit, then source it before any command.
# Relative directory paths resolve against the BACAM repository, not the shell cwd.
export BACAM_MODEL_ROOT="models"
export BACAM_MERGE_ROOT="outputs/models"
export BACAM_DATA_ROOT="datasets"
export BACAM_EXTERNAL_ROOT="third_party"
# Individual checkouts can also be set independently:
# export BACAM_RESEARCH_ROOT="third_party/ReSearch"
# export BACAM_BFCL_ROOT="third_party/bfcl-toolrl"
# export BACAM_VERL_AGENT_ROOT="third_party/verl-agent"

# Defaults use Python from the current environment and commands from PATH.
# Each value is one executable path or command name, without extra arguments.
# export BACAM_PYTHON="/path/to/training-env/bin/python"
# export BACAM_TORCHRUN="/path/to/training-env/bin/torchrun"
# export BACAM_TOOL_PYTHON="/path/to/tool-env/bin/python"
# export BACAM_BFCL="/path/to/tool-env/bin/bfcl"
# export BACAM_SEARCH_PYTHON="/path/to/search-env/bin/python"
# export BACAM_ALFWORLD_PYTHON="/path/to/alfworld-env/bin/python"
# export BACAM_WEBSHOP_PYTHON="/path/to/webshop-env/bin/python"
# export BACAM_VLLM="/path/to/inference-env/bin/vllm"

# Four physical GPUs, assigned to Tool/Search/ALFWorld/WebShop in this order.
# Training and teacher caches use the same four GPUs.
# export BACAM_GPUS="0,1,2,3"
# Shift all service ports and the torchrun port for an independent run.
# export BACAM_PORT_OFFSET="1000"
# Individual ports override the offset; defaults are in experiment.json.
# export BACAM_RETRIEVER_PORT="8100"
# export BACAM_TOOL_PORT="19300"
# export BACAM_MASTER_PORT="29500"
# export BACAM_RETRIEVER_CONFIG="/path/to/retriever_config.yaml"
