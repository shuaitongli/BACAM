+    def _cache_path(self):
+        """Keep the resume cache outside timestamped output directories."""
+        save_dir = self.config["save_dir"].rstrip("/")
+        split = self.config["split"]
+        split = "_".join(split) if isinstance(split, (list, tuple)) else str(split)
+        return os.path.join(os.path.dirname(save_dir), f"cache_{self.config['dataset_name']}_{split}.jsonl")
+
+    @staticmethod
+    def _load_cache(path):
+        done = {}
+        if os.path.exists(path):
+            with open(path, encoding="utf-8") as f:
+                for line in f:
+                    try:
+                        rec = json.loads(line)
+                    except json.JSONDecodeError:
+                        continue  # Ignore an interrupted trailing record.
+                    done[rec["key"]] = rec["output"]
+        return done
+
